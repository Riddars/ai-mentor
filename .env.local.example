# GitHub App credentials (see the app settings page after registration).
GITHUB_APP_ID=

# Provide the private key EITHER as a path to the downloaded .pem file
# OR as its base64-encoded contents. The path variant is simplest locally.
GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_PRIVATE_KEY_BASE64=

# The webhook secret configured in the GitHub App.
GITHUB_WEBHOOK_SECRET=

# Organization holding the project repositories and its template repository: the panel links
# to them when a new project is set up.
GITHUB_ORG=RiddarsCorp
# GITHUB_TEMPLATE_REPO=project-template

# smee.io channel set as the app's Webhook URL; forwarded to the local service with
# npx smee-client (see docs/документация/запуск.md).
SMEE_URL=https://smee.io/WVSknT6PNVXhHNbj

# Who reviews a pull request.
#   simulate - stub answer, no language model (uses CURATOR_SIM_MODE below)
#   llm      - real review by a language model (uses LLM_PROVIDER below)
# Required in production: without it the server refuses to start.
CURATOR_REVIEWER=simulate

# Simulation of the language model (used only when CURATOR_REVIEWER=simulate).
#   manual       - create the check as in_progress and wait for a manual conclude call
#   auto-approve - after a delay, comment and conclude the check as success
#   auto-block   - after a delay, comment and conclude as action_required (merge stays blocked)
#   offline      - ignore the event entirely (service-unavailable scenario)
CURATOR_SIM_MODE=manual
CURATOR_SIM_DELAY_MS=8000

# Shared secret protecting the manual conclude endpoint. Required only with CURATOR_REVIEWER=simulate.
SIM_ADMIN_TOKEN=

# Project memory (stage 3). SQLite file path, relative to the app working directory.
# The directory is created automatically; the file and its WAL siblings are gitignored.
DATABASE_PATH=./data/curator.db

# --- Supervisor panel (stage 5) ---
# Secret for signing session tokens. Any long random string. Without it the panel
# is open in development and closed (fail closed) in production.
AUTH_SECRET=
# First head account, created on first login when the user table is empty.
HEAD_LOGIN=head
HEAD_PASSWORD=
# Enable POST /api/dev/seed to load demo data (also enabled automatically in dev).
ALLOW_DEV_SEED=

# --- Language model (used when CURATOR_REVIEWER=llm) ---
# The provider is NOT fixed — see docs/документация/принятые решения.md. Switching to
# Claude later means adding one adapter in lib/llm/chat.ts and setting LLM_PROVIDER=anthropic.
# OpenAI-compatible providers supported now: provod, selectel, openai, openrouter.
# The exact model id — from GET {provider base URL}/models.
LLM_PROVIDER=provod
LLM_MODEL=deepseek/deepseek-v4-pro

# Optional fallback: if the primary provider fails, one retry on this provider/model.
# LLM_FALLBACK_PROVIDER=selectel
# LLM_FALLBACK_MODEL=deepseek/deepseek-v4-flash

# Request limits: answer size in tokens, sampling temperature (low keeps reviews stable),
# and how long to wait for the model before the review counts as failed.
# LLM_MAX_TOKENS=8000
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_MS=300000
# off — turn model reasoning off (router-style `reasoning` parameter: selectel, openrouter)
# LLM_REASONING=off

# --- Review queue (used when CURATOR_REVIEWER=llm) ---
# Wait for further commits before reviewing (only the latest is reviewed); conclude the
# required check as "not reviewed" after the deadline so it never blocks merging for long;
# model requests per project per 24 hours; how long a failing review keeps retrying;
# reviews running at once (always one per project).
# REVIEW_DEBOUNCE_MS=10000
# REVIEW_DEADLINE_MS=1800000
# REVIEW_DAILY_LIMIT=50
# REVIEW_RETRY_WINDOW_MS=86400000
# REVIEW_CONCURRENCY=1
# Tokens of all model requests in 24 hours, per project and for the whole service (agent,
# diff review, verification, failed runs included); over a budget the check is concluded
# "not reviewed" and the review waits. 0 — no limit. A project overview starts only with room for
# its whole run (600000 tokens), so a budget must be larger than that.
# TOKENS_PER_PROJECT_DAY=1000000
# TOKENS_PER_DAY=5000000

# Heartbeat for an external monitor (e.g. CronBox): every 5 minutes the review queue sends a
# GET to this URL while reviews are getting done; it stops when the service is down or reviews
# are failing or overdue, and the monitor alerts on the silence. Empty — no heartbeat.
# HEARTBEAT_URL=

# --- Agent review ---
# agent (default) — the model reads a copy of the repository at the PR commit through read-only
# tools (lib/agent), falling back to diff if the agent fails; diff — one model request over the
# PR changes. Needs an OpenAI-compatible LLM_PROVIDER; replies to comments always go through diff.
# REVIEW_MODE=agent
# Agent model (default: LLM_MODEL), tool call limit, token budget and time limit per run.
# AGENT_MODEL=deepseek/deepseek-v4-pro
# AGENT_MAX_TOOL_CALLS=30
# AGENT_TOKENS_PER_RUN=400000
# AGENT_TIMEOUT_MS=600000

# Provider keys (fill the ones you use).
# provod.ai — Russian OpenAI-compatible gateway (key sk_..., billed in RUB).
PROVOD_API_KEY=
# Selectel AI router (OpenAI-compatible).
SELECTEL_API_KEY=
# OpenRouter (OpenAI-compatible).
OPENROUTER_API_KEY=
# OpenAI.
OPENAI_API_KEY=
