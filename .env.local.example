# GitHub App credentials (see the app settings page after registration).
GITHUB_APP_ID=

# Provide the private key EITHER as a path to the downloaded .pem file
# OR as its base64-encoded contents. The path variant is simplest locally.
GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_PRIVATE_KEY_BASE64=

# The webhook secret configured in the GitHub App.
GITHUB_WEBHOOK_SECRET=

# Who reviews a pull request.
#   simulate - stub answer, no language model (uses CURATOR_SIM_MODE below)
#   llm      - real review by a language model (uses LLM_PROVIDER below)
CURATOR_REVIEWER=simulate

# Simulation of the language model (used only when CURATOR_REVIEWER=simulate).
#   manual       - create the check as in_progress and wait for a manual conclude call
#   auto-approve - after a delay, comment and conclude the check as success
#   auto-block   - after a delay, comment and conclude as action_required (merge stays blocked)
#   offline      - ignore the event entirely (service-unavailable scenario)
CURATOR_SIM_MODE=manual
CURATOR_SIM_DELAY_MS=8000

# Shared secret protecting the manual conclude endpoint.
SIM_ADMIN_TOKEN=

# --- Language model (used when CURATOR_REVIEWER=llm) ---
# The provider is NOT fixed — see docs/документация/принятые решения.md. Switching to
# Claude later means adding one adapter in lib/llm/chat.ts and setting LLM_PROVIDER=anthropic.
# OpenAI-compatible providers supported now: provod, selectel, openai, openrouter.
# The exact model id — from GET {provider base URL}/models.
LLM_PROVIDER=provod
LLM_MODEL=deepseek/deepseek-v4-pro

# Optional fallback: if the primary provider fails, one retry on this provider/model.
# LLM_FALLBACK_PROVIDER=selectel
# LLM_FALLBACK_MODEL=deepseek/deepseek-v4-flash

# Provider keys (fill the ones you use).
# provod.ai — Russian OpenAI-compatible gateway (key sk_..., billed in RUB).
PROVOD_API_KEY=
# Selectel AI router (OpenAI-compatible).
SELECTEL_API_KEY=
# OpenRouter (OpenAI-compatible).
OPENROUTER_API_KEY=
# OpenAI.
OPENAI_API_KEY=
