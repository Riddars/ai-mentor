# GitHub App credentials (see the app settings page after registration).
GITHUB_APP_ID=

# Provide the private key EITHER as a path to the downloaded .pem file
# OR as its base64-encoded contents. The path variant is simplest locally.
GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_PRIVATE_KEY_BASE64=

# The webhook secret configured in the GitHub App.
GITHUB_WEBHOOK_SECRET=

# Who reviews a pull request.
#   simulate - stub answer, no language model (uses CURATOR_SIM_MODE below)
#   provod   - real review via the provod.ai gateway (requires PROVOD_API_KEY)
CURATOR_REVIEWER=simulate

# Simulation of the language model (used only when CURATOR_REVIEWER=simulate).
#   manual       - create the check as in_progress and wait for a manual conclude call
#   auto-approve - after a delay, comment and conclude the check as success
#   auto-block   - after a delay, comment and conclude as action_required (merge stays blocked)
#   offline      - ignore the event entirely (service-unavailable scenario)
CURATOR_SIM_MODE=manual
CURATOR_SIM_DELAY_MS=8000

# Shared secret protecting the manual conclude endpoint.
SIM_ADMIN_TOKEN=

# --- provod.ai (Russian OpenAI-compatible LLM gateway, key looks like sk_..., billed in RUB) ---
# Used when CURATOR_REVIEWER=provod. The exact model id — from GET https://api.provod.ai/v1/models.
PROVOD_API_KEY=
PROVOD_MODEL=deepseek/deepseek-v4-pro
# PROVOD_BASE_URL=https://api.provod.ai/v1
